# CLARO — devnet only. Nunca commitear el .env.local real ni los secrets.

# RPC (devnet público por defecto)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_CLUSTER=devnet

# Mint USDC de prueba propio (lo genera scripts/setup_devnet.ts)
CLARO_USDC_MINT=
NEXT_PUBLIC_USDC_MINT=

# Signers de DEMO (server-side, SOLO devnet — generados por setup_devnet.ts)
# Formato: base58 del seed Ed25519 crudo de 32 bytes
CLARO_MINT_AUTHORITY_SECRET=
# base58 secrets del payer pool, separados por coma (5)
CLARO_PAYER_SECRETS=

# Secret para firmar cookies de sesión demo (cualquier string random largo)
CLARO_SESSION_SECRET=cambia-esto-por-un-string-largo-random
